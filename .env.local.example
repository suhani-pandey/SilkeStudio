# Copy this file to .env.local and fill in the values.

# --- Required: Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public address of the site. Used in SMS links and the password-reset email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: SMS confirmations (gatewayapi.com) ---
# Leave blank and nothing is sent and nothing is charged.
GATEWAYAPI_TOKEN=
# Your mobile, to receive a text on every new booking. Danish numbers can be written 12345678.
SALON_OWNER_PHONE=

# --- Optional: push notifications to the installed app ---
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Needed only so the server can look up which devices to notify (Project Settings → API).
SUPABASE_SERVICE_ROLE_KEY=
